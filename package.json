{
  "name": "svelte-a11y-panel",
  "version": "0.1.3",
  "description": "Accessible, configurable accessibility panel component for Svelte 5",
  "keywords": [
    "svelte",
    "svelte5",
    "accessibility",
    "a11y",
    "panel",
    "wcag",
    "sveltekit"
  ],
  "homepage": "https://a11y.clmartin.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtislmartin/svelte-a11y-panel.git"
  },
  "author": "Curtis Martin",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "svelte-a11y-panel": "bin/init.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cli": "tsup",
    "build:all": "pnpm build:cli && pnpm package",
    "package": "svelte-package && publint",
    "prepublishOnly": "pnpm build:all",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "prettier --check ."
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "publint": "^0.3.22",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": ">=0.7.0 <1.0.0"
    }
  }
}
