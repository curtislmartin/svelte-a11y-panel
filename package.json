{
  "name": "svelte-a11y-panel",
  "version": "0.1.1",
  "description": "Accessible, configurable accessibility panel component for Svelte 5",
  "keywords": [
    "svelte",
    "svelte5",
    "accessibility",
    "a11y",
    "panel",
    "wcag",
    "sveltekit"
  ],
  "homepage": "https://a11y.clmartin.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtislmartin/svelte-a11y-panel.git"
  },
  "author": "Curtis Martin",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "svelte-a11y-panel": "bin/init.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cli": "tsup",
    "build:all": "pnpm build:cli && pnpm package",
    "package": "svelte-package && publint",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "prettier --check ."
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.2.0",
    "@playwright/test": "^1.40.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "publint": "^0.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.1"
}
